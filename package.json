{
  "name": "otonommcp-external-idp",
  "version": "2.0.0",
  "description": "Local passkey (WebAuthn) identity provider that issues ES256-signed human approval and decision tokens for OtonomMCP",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node --no-warnings=ExperimentalWarning dist/main.js",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "contract-check": "npm run build && node --no-warnings=ExperimentalWarning scripts/contract-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naziffarm4/OtonomMCP-External-IdP.git"
  },
  "license": "ISC",
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  }
}
